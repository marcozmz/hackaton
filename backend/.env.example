# Copie para .env. Nunca commite o .env.
APP_ENV=development
SECRET_KEY=troque-isto
# DATABASE_URL=sqlite:///instance/plantefacil.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/plantefacil
CORS_ORIGINS=*
GEOCODING_CEP_PROVIDER=viacep
RATELIMIT_DEFAULT=60 per minute
RECOMMENDATION_CACHE_TTL=1800
# IA (opcional): chave do Google AI Studio (começa com AIza). Sem chave = só templates.
LLM_API_KEY=
# LLM_PROVIDER=gemini   # gemini | ollama | none
# LLM_MODEL=gemini-2.5-flash
# Mapa da landing (token público Mapbox pk...). Sem token = landing sem mapa.
MAPBOX_TOKEN=

# Aviso diário por e-mail (webhook do cenário Make.com). Vazio = avisos desligados.
MAKE_WEBHOOK_URL=
ALERTS_HOUR=6
